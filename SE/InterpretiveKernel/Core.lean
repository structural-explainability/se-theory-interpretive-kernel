/-!
# SE.InterpretiveKernel.Core

Order conventions and equivalence closure. Lean core only (no Mathlib).

## Ordering convention (stipulation)

For binary relations `R S : α → α → Prop`:

    Finer R S  :=  ∀ x y, R x y → S x y

This is relation inclusion `R ⊆ S`. For equivalence relations it means the
partition of `R` REFINES the partition of `S`: `R` is FINER, `S` is COARSER.
In the task statement and the documentation, `R ≤ S` means `Finer R S`.

Examples of direction:
* equality is the finest equivalence relation: `Finer Eq R` for every reflexive `R`;
* the total relation is the coarsest: `Finer R (fun _ _ => True)` for every `R`.

Mathematical equality `=` of relations (extensional) is distinct from any
declared identity of intended real-world frames; nothing in this file
concerns declared identity.
-/

@[expose] public section

namespace SE.InterpretiveKernel

universe u v w

/-- `Finer R S`: relation inclusion `R ⊆ S`.  For equivalence relations,
`R` is a finer partition than `S`.  This is the task's `R ≤ S`. -/
def Finer {α : Type u} (R S : α → α → Prop) : Prop :=
  ∀ x y, R x y → S x y

/-- `Coarser R S` is `Finer S R`. -/
def Coarser {α : Type u} (R S : α → α → Prop) : Prop :=
  Finer S R

/-- Reflexivity of `Finer`. -/
theorem Finer.refl {α : Type u} (R : α → α → Prop) : Finer R R :=
  fun _ _ h => h

/-- Transitivity of `Finer`. -/
theorem Finer.trans {α : Type u} {R S T : α → α → Prop}
    (hRS : Finer R S) (hST : Finer S T) : Finer R T :=
  fun x y h => hST x y (hRS x y h)

/-- Mutual inclusion gives extensional equality of relations. -/
theorem Finer.antisymm {α : Type u} {R S : α → α → Prop}
    (hRS : Finer R S) (hSR : Finer S R) : R = S := by
  funext x y
  exact propext ⟨hRS x y, hSR x y⟩

/-- `Finer` is exactly core's `Subrelation` (with explicit binders). -/
theorem finer_iff_subrelation {α : Type u} {R S : α → α → Prop} :
    Finer R S ↔ Subrelation R S :=
  ⟨fun h _ _ hxy => h _ _ hxy, fun h _ _ hxy => h hxy⟩

/-- Equality is the finest equivalence: it is finer than every reflexive relation. -/
theorem finer_eq_of_refl {α : Type u} {R : α → α → Prop}
    (hR : ∀ x, R x x) : Finer (fun x y : α => x = y) R := by
  intro x y h
  subst h
  exact hR x

/-- The total relation is the coarsest relation. -/
theorem finer_total {α : Type u} (R : α → α → Prop) :
    Finer R (fun _ _ => True) :=
  fun _ _ _ => True.intro

/-! ## Equivalence closure

Core Lean provides `Equivalence` and `Relation.TransGen` but no equivalence
closure, so it is defined here. -/

/-- The equivalence relation generated by `r`: the least equivalence relation
containing `r` (minimality is `EqvClosure.le_of_equivalence`). -/
inductive EqvClosure {α : Type u} (r : α → α → Prop) : α → α → Prop where
  | of    {a b : α} : r a b → EqvClosure r a b
  | refl  (a : α) : EqvClosure r a a
  | symm  {a b : α} : EqvClosure r a b → EqvClosure r b a
  | trans {a b c : α} : EqvClosure r a b → EqvClosure r b c → EqvClosure r a c

namespace EqvClosure

variable {α : Type u} {r s t : α → α → Prop}

/-- The closure is an equivalence relation. -/
theorem equivalence (r : α → α → Prop) : Equivalence (EqvClosure r) where
  refl  := EqvClosure.refl
  symm  := EqvClosure.symm
  trans := EqvClosure.trans

/-- The closure contains the generating relation. -/
theorem subset (r : α → α → Prop) : Finer r (EqvClosure r) :=
  fun _ _ h => EqvClosure.of h

/-- Minimality: any equivalence relation containing `r` contains its closure. -/
theorem le_of_equivalence (ht : Equivalence t) (h : Finer r t) :
    Finer (EqvClosure r) t := by
  intro x y hxy
  induction hxy with
  | of hab        => exact h _ _ hab
  | refl a        => exact ht.refl a
  | symm _ ih     => exact ht.symm ih
  | trans _ _ ih1 ih2 => exact ht.trans ih1 ih2

/-- The closure operator is monotone in the generating relation. -/
theorem monotone (h : Finer r s) : Finer (EqvClosure r) (EqvClosure s) :=
  le_of_equivalence (equivalence s) (Finer.trans h (subset s))

end EqvClosure

end SE.InterpretiveKernel
