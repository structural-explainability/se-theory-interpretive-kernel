module

public import SE.InterpretiveKernel.Lifting

/-!
# SE.InterpretiveKernel.Adjunction

    L_Q(φ) ≤ ρ   ↔   φ ≤ K_Q(ρ)        (for `ρ` an equivalence relation)

between the posets of relations ordered by `Finer`.  `φ` may be any relation;
the theorem needs no hypothesis on `φ`.  Taking `φ` an equivalence relation
gives the intended adjunction on equivalence relations.

Novelty note: this is an instance of a standard Galois connection (closure
generated by a relation / its right adjoint along a function-like map).
No claim of novelty is made for the adjunction itself.
-/

@[expose] public section

namespace SE.InterpretiveKernel

universe u v w

variable {E : Type u} {A : Type v} {P : Type w}

/-- Central theorem: `L_Q ⊣ K_Q`. -/
theorem adjunction (I : P → E → A) (Q : P → Prop)
    {φ : E → E → Prop} {ρ : A → A → Prop} (hρ : Equivalence ρ) :
    Finer (liftRel I Q φ) ρ ↔ Finer φ (kernelRel I Q ρ) := by
  constructor
  · intro h e e' hφ p hp
    exact h _ _ (liftRel_of_pair I Q hp hφ)
  · intro h
    exact liftRel_le_of_generators I Q hρ (fun p e e' hp hφ => h e e' hφ p hp)

/-- Adjunction stated with coherence. -/
theorem lift_le_iff_coherent (I : P → E → A) (Q : P → Prop)
    {φ : E → E → Prop} {ρ : A → A → Prop} (hρ : Equivalence ρ) :
    Finer (liftRel I Q φ) ρ ↔ Coherent I Q φ ρ :=
  adjunction I Q hρ

/-- Unit: `φ ≤ K_Q(L_Q(φ))`.  No hypotheses. -/
theorem unit (I : P → E → A) (Q : P → Prop) (φ : E → E → Prop) :
    Finer φ (kernelRel I Q (liftRel I Q φ)) :=
  fun _ _ hφ _ hp => liftRel_of_pair I Q hp hφ

/-- Counit: `L_Q(K_Q(ρ)) ≤ ρ`.  Needs `ρ` to be an equivalence relation. -/
theorem counit (I : P → E → A) (Q : P → Prop)
    {ρ : A → A → Prop} (hρ : Equivalence ρ) :
    Finer (liftRel I Q (kernelRel I Q ρ)) ρ :=
  (adjunction I Q hρ).2 (Finer.refl _)

/-- Closure-operator fact: `L K L = L`. -/
theorem lift_kernel_lift (I : P → E → A) (Q : P → Prop) (φ : E → E → Prop) :
    liftRel I Q (kernelRel I Q (liftRel I Q φ)) = liftRel I Q φ :=
  Finer.antisymm
    (counit I Q (liftRel_equivalence I Q φ))
    (liftRel_monotone I Q (unit I Q φ))

/-- Closure-operator fact: `K L K = K` (for `ρ` an equivalence relation). -/
theorem kernel_lift_kernel (I : P → E → A) (Q : P → Prop)
    {ρ : A → A → Prop} (hρ : Equivalence ρ) :
    kernelRel I Q (liftRel I Q (kernelRel I Q ρ)) = kernelRel I Q ρ :=
  Finer.antisymm
    (kernelRel_monotone I Q (counit I Q hρ))
    (unit I Q (kernelRel I Q ρ))

/-- Bundled adjunction on setoids. -/
theorem adjunction_setoid (I : P → E → A) (Q : P → Prop)
    (φ : Setoid E) (ρ : Setoid A) :
    Finer (liftSetoid I Q φ.r).r ρ.r ↔ Finer φ.r (kernelSetoid I Q ρ).r :=
  adjunction I Q ρ.iseqv

end SE.InterpretiveKernel
